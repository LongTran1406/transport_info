NSW_TRANSPORT_API_KEY=your-tfnsw-api-key
MINIO_ROOT_USER=transport-admin
MINIO_ROOT_PASSWORD=change-me-min-8-chars
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me-hex-only
AIRFLOW_ADMIN_PASSWORD=change-me

# Failure alerts (freshness DAG). Leave ALERT_EMAIL empty to disable email.
ALERT_EMAIL=you@example.com
# Example for Gmail: use an app password, not your account password.
AIRFLOW__SMTP__SMTP_HOST=smtp.gmail.com
AIRFLOW__SMTP__SMTP_PORT=587
AIRFLOW__SMTP__SMTP_STARTTLS=True
AIRFLOW__SMTP__SMTP_SSL=False
AIRFLOW__SMTP__SMTP_USER=you@example.com
AIRFLOW__SMTP__SMTP_PASSWORD=your-app-password
AIRFLOW__SMTP__SMTP_MAIL_FROM=you@example.com
